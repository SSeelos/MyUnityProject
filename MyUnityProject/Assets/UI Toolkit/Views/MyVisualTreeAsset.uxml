<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/MyStyles.uss?fileID=7433441132597879392&amp;guid=0cdffb4321b12da4fad0b9137f2e9b48&amp;type=3#MyStyles"/>
    <ui:VisualElement picking-mode="Ignore" name="mainV" style="flex-grow: 1;">
        <ui:VisualElement name="topPanel" picking-mode="Ignore" style="flex-grow: 0; flex-direction: row;">
            <ui:Button text="Menu" name="menuBtn"/>
        </ui:VisualElement>
        <ui:VisualElement name="midPanel" picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="leftPanel" picking-mode="Ignore" style="flex-grow: 1;">
                <MyVisualElement my-string="myValue"/>
            </ui:VisualElement>
            <ui:VisualElement name="centerPanel" picking-mode="Ignore" style="flex-grow: 1;"/>
            <ui:VisualElement name="rightPanel" picking-mode="Ignore" style="flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="botPanel" picking-mode="Ignore" style="flex-grow: 0; flex-direction: row;"/>
    </ui:VisualElement>
    <ui:VisualElement name="menuV" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.59); align-items: center; justify-content: center; display: none;">
        <ui:Button text="Return" name="returnBtn"/>
        <ui:Button text="MainMenu" name="mainMenuBtn"/>
    </ui:VisualElement>
</ui:UXML>
